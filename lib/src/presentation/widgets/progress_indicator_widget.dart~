import 'package:flutter/material.dart';
import 'package:mova/src/config/theme/color_schemes.dart';
import 'package:mova/src/di/data_layer_injector.dart';
import 'package:mova/src/domain/usecase/get_language_use_case.dart';

class ProgressIndicatorWidget extends StatelessWidget {
  final double percentage;

  const ProgressIndicatorWidget({
    super.key,
    required this.percentage,
  });

  @override
  Widget build(BuildContext context) {
    final totalWidth = MediaQuery.of(context).size.width;
    final clampedPercentage = (percentage / 100).clamp(0.0, 1.0);
    final activeWidth = totalWidth * clampedPercentage;

    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 16),
      child: Stack(
        children: [
          // Background Bar
          Container(
            width: totalWidth,
            height: 12,
            decoration: BoxDecoration(
              color: const Color.fromRGBO(230, 233, 240, 1),
              borderRadius: BorderRadius.circular(12),
            ),
          ),
          // Active Progress Bar
          Stack(
            children: [
              Container(
                width: activeWidth,
                height: 12,
                decoration: BoxDecoration(
                  color: ColorSchemes.progressColor,
                  borderRadius: BorderRadius.circular(12),
                ),
              ),
              Positioned(
                left: GetLanguageUseCase(injector())() == 'ar' ? 15 : null,
                right: GetLanguageUseCase(injector())() == 'en' ? 15 : null,
                child: Text(
                  '${(clampedPercentage * 100).toInt()}%',
                  style: Theme.of(context).textTheme.labelSmall?.copyWith(
                        color: Colors.white,
                        fontSize: 11,
                        fontWeight: FontWeight.w500,
                      ),
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }
}
