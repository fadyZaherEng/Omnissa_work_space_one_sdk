import 'dart:io';
import 'package:device_info_plus/device_info_plus.dart';
import 'package:flutter/foundation.dart';
import 'package:mova/src/core/resources/shared_preferences_keys.dart';
import 'package:shared_preferences/shared_preferences.dart';
import "package:universal_html/html.dart" as html;
import 'package:package_info_plus/package_info_plus.dart';

final class SetDeviceInfoUseCase {
  SharedPreferences sharedPreferences;
  String userAgent = html.window.navigator.userAgent;

  SetDeviceInfoUseCase(this.sharedPreferences);

  Future<bool> call() async {
    String deviceType = await _getDeviceType();
    String osVersion = "$deviceType ${await _getOSVersion()}";
    String appVersion = await _getAppVersion();
    DeviceInfo deviceInfo = DeviceInfo(
      osVersion: osVersion,
      appVersion: appVersion,
      deviceType: deviceType,
    );
    return await sharedPreferences.setString(
        SharedPreferenceKeys.deviceInfo, deviceInfo.toJson());
  }

  Future<String> _getOSVersion() async {
    DeviceInfoPlugin deviceInfo = DeviceInfoPlugin();
    String osVersion = '';
    if (Platform.isAndroid) {
      AndroidDeviceInfo androidInfo = await deviceInfo.androidInfo;
      osVersion = androidInfo.version.release;
    } else if (Platform.isIOS) {
      IosDeviceInfo iosInfo = await deviceInfo.iosInfo;
      osVersion = iosInfo.systemVersion;
    } else if (Platform.isMacOS) {
      MacOsDeviceInfo macInfo = await deviceInfo.macOsInfo;
      osVersion = macInfo.osRelease;
    } else if (Platform.isWindows) {
      WindowsDeviceInfo windowsInfo = await deviceInfo.windowsInfo;
      osVersion = '${windowsInfo.majorVersion}';
    } else if (Platform.isLinux) {
      LinuxDeviceInfo linuxInfo = await deviceInfo.linuxInfo;
      osVersion = '${linuxInfo.version}';
    } else if (kIsWeb) {
      WebBrowserInfo webBrowserInfo = await deviceInfo.webBrowserInfo;
      osVersion = '${webBrowserInfo.platform}';
    } else {
      osVersion = 'Unknown OS';
    }
    return osVersion;
  }

  Future<String> _getDeviceType() async {
    String deviceType = "";
    if (kIsWeb) {
      deviceType = 'web';
    } else if (Platform.isIOS) {
      deviceType = 'ios';
    } else if (Platform.isAndroid) {
      deviceType = await _checkHuaweiOrAndroid();
    } else if (Platform.isMacOS) {
      deviceType = 'macos';
    } else if (Platform.isWindows) {
      deviceType = 'windows';
    } else if (Platform.isLinux) {
      deviceType = 'linux';
    } else if (!kIsWeb) {
      if (_isOpenedInBrowser()) {
        if (Platform.isIOS) {
          deviceType = 'ios';
        } else if (Platform.isAndroid) {
          deviceType = await _checkHuaweiOrAndroid();
        }
      } else {
        deviceType = 'unknown';
      }
    } else {
      deviceType = 'unknown';
    }
    return deviceType;
  }

  bool _isOpenedInBrowser() =>
      userAgent.contains('Chrome') ||
      userAgent.contains('Edge') ||
      userAgent.contains('google') ||
      userAgent.contains('Safari') ||
      userAgent.contains('Firefox');

  Future<String> _getAppVersion() async {
    return (await PackageInfo.fromPlatform()).version;
  }

  Future<String> _checkHuaweiOrAndroid() async {
    String deviceType = "";
    AndroidDeviceInfo deviceInfo = await (DeviceInfoPlugin().androidInfo);
    if (deviceInfo.brand.toLowerCase() == 'huawei' ||
        deviceInfo.brand.toLowerCase() == 'honor') {
      if (deviceInfo.version.codename == 'H' ||
          deviceInfo.version.release.startsWith('2.')) {
        deviceType = 'huawei';
      } else {
        deviceType = 'android';
      }
    } else {
      deviceType = 'android';
    }
    return deviceType;
  }
}
